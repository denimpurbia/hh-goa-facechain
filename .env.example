# ==========================================
# FaceChain Verify - Environment Configuration
# ==========================================

# Reverse Image Search Configuration
# Get your API key from https://serpapi.com
SERPAPI_API_KEY=

# Search Provider: serpapi (default)
SEARCH_PROVIDER=serpapi
SEARCH_TIMEOUT=30
MAX_SEARCH_RESULTS=10

# Face Matching Configuration
# Cosine similarity threshold for considering two face embeddings a match (0.0 - 1.0)
FACE_MATCH_THRESHOLD=0.60

# Blockchain Configuration
# Options: ethereum_tester (default local testnet), http_rpc (custom node)
BLOCKCHAIN_PROVIDER=ethereum_tester
BLOCKCHAIN_RPC_URL=

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
